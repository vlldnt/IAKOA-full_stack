# Configuration des tests — copiez ce fichier vers .env.test.
# La base de test est fournie par docker-compose (racine du repo) :
#   docker compose up -d db-test
# .env.test n'est PAS versionné : n'y mettez jamais de secrets partagés.
DATABASE_URL="postgresql://iakoa_test:iakoa_test@127.0.0.1:5433/iakoa-tests?schema=public"
JWT_SECRET="test-secret-key"
JWT_REFRESH_SECRET="test-refresh-secret"
NODE_ENV="test"
PORT=3001
