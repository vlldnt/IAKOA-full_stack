# Configuration des tests — copiez ce fichier vers .env.test et renseignez les valeurs.
# .env.test n'est PAS versionné : n'y mettez jamais de secrets partagés.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/iakoa-tests?schema=public"
JWT_SECRET="test-secret-key"
JWT_REFRESH_SECRET="test-refresh-secret"
NODE_ENV="test"
PORT=3001
